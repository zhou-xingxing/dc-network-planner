# SQLAlchemy 数据库连接地址
DATABASE_URL=sqlite:///./hcs_lld.db

# 应用业务时区，用于解释定时备份 cron 等业务时间
APP_TIMEZONE=Asia/Shanghai

# 导入预览数据保留时长（分钟）
IMPORT_TTL_MINUTES=30

# 本地备份默认目录与后台调度扫描周期
BACKUP_DEFAULT_LOCAL_PATH=./backups
BACKUP_SCHEDULER_INTERVAL_SECONDS=60

# 允许跨域访问的前端地址列表
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# JWT 签名密钥，生产环境必须改成高强度随机值
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# 初始管理员账户，仅在 users 表为空时自动创建
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
